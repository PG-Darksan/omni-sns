{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniSNS",
  "version": "1.8.5",
  "identifier": "com.pgdarksan.omnisns",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; frame-ancestors 'none'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' https: http: data:; style-src 'self' 'unsafe-inline'; script-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Darksan",
    "copyright": "Copyright © 2026 Darksan",
    "shortDescription": "全SNS・マッチングアプリ統合メッセージングブラウザ",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
