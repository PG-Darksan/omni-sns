{
  "name": "omni-sns",
  "version": "1.1.0",
  "description": "Windows向け 全SNS・マッチングアプリ統合メッセージングブラウザ (All-in-One SNS & Matching Desk)",
  "author": "Darksan",
  "license": "MIT",
  "keywords": [
    "tauri",
    "windows",
    "webview2",
    "sns",
    "messaging",
    "matching-app",
    "browser",
    "all-in-one"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "export:catalog": "node scripts/export-catalog.mjs",
    "typecheck": "tsc --noEmit",
    "start": "tauri dev",
    "dev": "tauri dev",
    "test:ts": "npm run build && node --test dist/tests/core.test.js",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "npm run test:ts && npm run test:rust",
    "dist:win": "node scripts/dist-win.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
